# --- Database ---
# Turso (production)
DATABASE_URL="libsql://db-name-user.turso.io"
DATABASE_AUTH_TOKEN=""
# Local SQLite file (dev)
# DATABASE_URL="file:local.db"

# --- First-user bootstrap ---
# On first boot with no users in the DB, the app creates an admin account
# from these values. Once any user exists these vars are ignored.
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="changeme"
